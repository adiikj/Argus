# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.next/
out/
.turbo/
*.tsbuildinfo

# Prisma generated client
**/generated/
prisma/*.db

# Env / secrets — every real env file; only the *.example templates are tracked
.env
.env.*
!.env*.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage / test — test-coverage output only; a bare "coverage/" also
# matched the dashboard's /coverage route (src/app/(app)/coverage)
/coverage/
/apps/*/coverage/
/packages/*/coverage/
.nyc_output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

#docs
*.md
!README.md
/docs

# database dumps from deploy/vm.sh backup
backups/
