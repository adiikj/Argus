# Env for docker-compose.vm.yml (VM backend; the dashboard is on Vercel).
#   cp .env.vm.example .env.vm && chmod 600 .env.vm
# .env.vm is gitignored — it holds real secrets.

# --- Required ---
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32 — signs session tokens; rotating it logs everyone out
AUTH_SECRET=
# the Vercel dashboard origin(s), comma-separated, no trailing slash
#   e.g. https://argus.vercel.app,https://argus.example.com
CORS_ORIGIN=

# --- Reverse proxy ---
# ONE public HTTPS hostname serves both backends: /simulate* -> generator,
# everything else (REST + /ws) -> api. Must be HTTPS — the Vercel dashboard is
# served over TLS and browsers block plain http/ws from it. No domain? Azure
# gives the VM's public IP a free DNS label: <label>.<region>.cloudapp.azure.com
# Vercel then gets NEXT_PUBLIC_WS_URL=wss://$API_HOST/ws and
# NEXT_PUBLIC_GENERATOR_URL=https://$API_HOST
API_HOST=
# Let's Encrypt account email (only used by the bundled Caddy proxy)
ACME_EMAIL=
# loopback,uniquelocal fits both the bundled Caddy and a host nginx
# TRUST_PROXY=loopback,uniquelocal
# host-side ports (127.0.0.1 only) — change if another app already uses them
# API_HOST_PORT=4000
# GENERATOR_HOST_PORT=4200

# --- Images (built + scanned in CI) — pin a sha-<commit> tag to roll back ---
# ARGUS_API_IMAGE=ghcr.io/adiikj/argus-api:latest
# ARGUS_GENERATOR_IMAGE=ghcr.io/adiikj/argus-generator:latest

# --- Optional ---
# AI summaries: none | gemini | groq (none = deterministic template summaries)
LLM_PROVIDER=none
GEMINI_API_KEY=
GROQ_API_KEY=
# Sign in with Google (same value as the dashboard's NEXT_PUBLIC_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Slack-compatible webhook for high/critical incidents
SLACK_WEBHOOK_URL=
# dashboard link included in notifications
DASHBOARD_URL=
# EVENT_RETENTION_DAYS=7
# NOISE_INTERVAL_MS=3000
# DEMO_MODE=false
