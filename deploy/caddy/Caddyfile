# Bundled TLS proxy for docker-compose.vm.yml (`--profile caddy`). Caddy gets
# and renews the Let's Encrypt certificate for API_HOST on its own.
{
	email {$ACME_EMAIL}
}

{$API_HOST} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}

	# attack-simulator API (generator); its routes don't collide with the api's
	@simulator path /simulate /simulate/*
	reverse_proxy @simulator generator:4200

	# everything else: api REST + the /ws WebSocket (upgrades handled natively).
	# Caddy ignores X-Forwarded-For from clients by default and sends the real
	# peer address — exactly what the api's TRUST_PROXY expects.
	reverse_proxy api:4000
}
